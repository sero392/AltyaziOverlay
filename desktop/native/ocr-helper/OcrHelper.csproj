<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows.Media.Ocr sarmalayıcısı: Android'deki ML Kit metin tanımanın masaüstü karşılığı.
       Windows'un kendi OCR motoru; cihazda çalışır, ağ yok. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>altyazi-ocr</AssemblyName>
    <RootNamespace>AltyaziOcr</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
