<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- TV alıcısını yerel ağda bulmak (NSD / mDNS) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Diğer uygulamaların üzerinde altyazı penceresi -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- MediaProjection için Foreground Service (Android 9+ / 14+ tip zorunluluğu) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Android 13+ servis bildirimini gösterebilmek için -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <service
        android:name=".service.ScreenCaptureService"
        android:exported="false"
        android:stopWithTask="false"
        android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
