<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".apk" />
      <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
      <!-- Yalnızca APK'lar indirilebilir: masaüstü (.exe) ve LG (.ipk) paketleri sunulmaz. -->
      <remove fileExtension=".ipk" />
      <remove fileExtension=".exe" />
    </staticContent>
  </system.webServer>
</configuration>
